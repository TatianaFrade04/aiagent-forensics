{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "🐳 Build Docker Image",
            "type": "shell",
            "command": "docker build -t forensics-sandbox ./docker",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "📦 Install Python Dependencies",
            "type": "shell",
            "command": "pip install -r agent/requirements.txt",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "🔍 Test Container Mount",
            "type": "shell",
            "command": "docker run --rm --privileged --network none -v \"${input:forensicsPath}:/forensics_raw:ro\" forensics-sandbox ls /forensics/",
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "🛑 Stop & Remove Container",
            "type": "shell",
            "command": "docker stop forensics_sandbox; docker rm forensics_sandbox",
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "🚀 Run Agent",
            "type": "shell",
            "command": "cd agent && python main.py",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "forensicsPath",
            "type": "promptString",
            "description": "Caminho para a pasta com a imagem forense (ex: C:\\forensics-agent\\forensics_image)"
        }
    ]
}
